# LLM 백엔드 선택 — local(로컬 추론, 기본) | claude(Anthropic API 하이브리드)
LLM_BACKEND=local

# 로컬 추론 서버 (OpenAI 호환: Ollama / vLLM / llama.cpp server / LM Studio)
#   Ollama 기준: brew install ollama && ollama serve && ollama pull qwen3:8b
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3:8b
# 분석(요약)용 경량 모델 — 비우면 LOCAL_LLM_MODEL 사용 (예: qwen3:4b)
LOCAL_LLM_MODEL_CHEAP=
# CPU 추론은 느릴 수 있어 넉넉히 (초)
LOCAL_LLM_TIMEOUT_SECONDS=600
# 컨텍스트 창 크기 — 프롬프트+max_tokens가 이 값을 넘으면 경고 로그 출력.
# 주의: Ollama의 /v1 레이어는 options.num_ctx를 무시한다(0.31.1 확인).
# 실효 컨텍스트는 서버 기동 시 같은 값으로 지정할 것: OLLAMA_CONTEXT_LENGTH=16384 ollama serve
LOCAL_LLM_NUM_CTX=16384

# Anthropic API — LLM_BACKEND=claude 일 때만 필요, platform.claude.com 에서 발급
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
LLM_MODEL=claude-sonnet-4-6
LLM_MODEL_CHEAP=claude-haiku-4-5-20251001

# 골든 테스트 — 초안 diff를 스크래치 사본에 적용 후 실행할 검증 명령 (exit 0=통과)
# 비우면 검증 생략. mock 개발: python3 tests/golden_income_tax.py
# 회사: 사내 빌드/테스트 명령 (예: mvn -q test -Dtest=YearEndGoldenTest)
GOLDEN_TEST_CMD=
GOLDEN_TEST_TIMEOUT_SECONDS=300

# 법제처 OPEN API 인증키 (수집) — open.law.go.kr 에서 발급
LAW_API_OC=your_oc_key
# 시행령·시행규칙 수집 포함 — 위임 수치(총급여 기준·간이세액표 등) 개정 감지에 필수
COLLECT_DECREES=true
# 도메인별 수집 대상(법령·행정규칙 검색어)은 domains.json에서 관리한다.
# 아래 ADMIN_RULE_QUERIES는 domains.json이 없을 때만 쓰는 폴백 (쉼표 구분).
# 주의: 행정규칙 수집은 OC 키에 행정규칙 목록/본문 API를 별도 신청해야 함 (open.law.go.kr)
DOMAINS_FILE=domains.json
ADMIN_RULE_QUERIES=

# 참고 문서(개정세법 해설 PDF 등) 업로드 폴더 — 프로젝트 문서(docs/)와 분리, gitignore 대상
DOCS_DIR=data/uploads

# DB (개발: SQLite)
DATABASE_URL=sqlite:///./regtax.db

# 임베딩 모델 (로컬, 한국어 강함) — M1/CPU에서 동작
EMBEDDING_MODEL=BAAI/bge-m3

# 실제 코드베이스 경로 (비워두면 mock_repo 사용, 경로 지정 시 RealCodebaseAdapter 전환)
# REPO_ROOT=C:/workspace/your-tax-repo
# 전체 repo 중 세금 관련 서브디렉토리만 인덱싱 (쉼표 구분, 비우면 전체)
# REPO_INDEX_PATHS=src/tax,src/salary,src/payroll
#
# 화이트리스트가 1차 방어다 — 경로별 산출물(web/eHR/ 컴파일본, nexacro14lib/ 벤더
# 런타임, UbiService/ 리포팅 엔진·로그)은 EXCLUDED_DIRS 블랙리스트로 잡히지 않으므로
# REPO_INDEX_PATHS로 범위를 좁혀 원천 차단한다. 비우면 전체 인덱싱이라 산출물·평문
# 자격증명(build.xml)까지 노출되니 실제 eHR에는 반드시 화이트리스트를 지정한다.
# eHR 권장 화이트리스트 (도메인: 급여·연말정산/연차/4대보험 + SQL + Nexacro 화면)
# REPO_INDEX_PATHS=src/hr/pay,src/hr/tim/annl,src/hr/ins,src/hr/sta/pay,src/hr/sqlmap,web/nexacro/solution/pay,web/nexacro/solution/tim,web/nexacro/solution/ins

# 회사 SSL 프록시 환경에서 HuggingFace 모델 다운로드 실패 시 True로 설정
HF_HUB_DISABLE_SSL=false

# 스케줄러 — true로 바꾸면 주기적으로 /collect 자동 실행
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_HOURS=24

# 검증 이력(verified/rejected/stale) 기반 검색 재정렬 — ADR-009, 기본 활성.
# false로 두면 재정렬 없이 #0009 검색 점수만 사용한다 (ablation 대조군).
VERIFIED_RERANKING_ENABLED=true
